MONGO_URI="Your_mongo_db_uri"
MONGO_DB="your_mongo_db name"
PORT=8080
JWT_SECRET="your_secret"
REMINDER_INTERVAL="5s"
REMINDER_WINDOW="3m"
REMINDER_WORKERS="3"
DB_DRIVER="postgres"
DATABASE_URL="postgres://postgres:CHANGE_ME@localhost:5432/taskmanager?sslmode=disable"
TEST_DATABASE_URL="postgres://postgres:CHANGE_ME@localhost:5432/taskmanager_test?sslmode=disable"
DB_MAX_CONNS=10